{
  "name": "@edgeproc/assay",
  "version": "0.5.0-dev.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "A Python and TypeScript library that combines several measurements into one score and shows exactly how it got there.",
  "keywords": [
    "scoring",
    "normalization",
    "weighted-mean",
    "explainability",
    "evaluation",
    "typescript"
  ],
  "license": "MIT",
  "author": "Harish Seshadri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hseshadr/assay.git",
    "directory": "ts"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "benchmark": "pnpm build && node benchmarks/release.mjs",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gate": "biome check . && tsc -p tsconfig.json --noEmit && vitest run --coverage && pnpm build"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
